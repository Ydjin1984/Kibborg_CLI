# Environment for `kibborg serve` under systemd. Copy to /etc/kibborg/serve.env,
# fill in the token, then `chmod 600` and `chown kibborg:kibborg` it.
#
# The token is what makes a reachable bind safe: without it the launcher refuses
# to start outside loopback. Generate one with: openssl rand -hex 32
KIBBORG_SERVER_TOKEN=replace-me-with-a-long-random-value

# 127.0.0.1 keeps the API on this machine (reach it through an SSH tunnel or a
# reverse proxy). Use 0.0.0.0 only together with the token above.
KIBBORG_SERVE_HOST=127.0.0.1
KIBBORG_SERVE_PORT=7317

# Provider credentials the host needs; the same references `kibborg auth` shows.
DEEPSEEK_API_KEY=replace-me
